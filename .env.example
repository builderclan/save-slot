# Supabase Public API Configuration (Client-side & Server-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side PostgreSQL Database Connection (Supabase Transaction Pooler)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres
# Database Security & TLS Configuration
# Supabase transaction poolers use internal certificate chains. Default is 'false' (rejectUnauthorized: false).
# Set to 'true' only if you provide a custom CA certificate bundle in your Node runtime.
DB_SSL_REJECT_UNAUTHORIZED=false

# Security & Persona Gating
# Controls whether quick demo persona buttons are shown on /login. Set to 'false' in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false
